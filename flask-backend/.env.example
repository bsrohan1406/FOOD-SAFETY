# Generate a unique random value for SECRET_KEY. Never commit real secrets.
SECRET_KEY=replace-with-a-long-random-secret
# Local development:
DATABASE_URL=sqlite:///sentinel.db
# Production example (use a managed PostgreSQL URL from your host):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
UPLOAD_FOLDER=./instance/private_uploads
MAX_UPLOAD_MB=8
COOKIE_SECURE=false
FLASK_DEBUG=true
DEMO_LOGIN_ENABLED=true
OTP_PROVIDER=console
# Configure real SMS/email provider credentials only in your hosting provider's secret manager.
